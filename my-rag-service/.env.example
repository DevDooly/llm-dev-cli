# ==============================================================================
# LLM Development Environment Variables (.env.example)
# ==============================================================================

# 1. LLM API Keys (절대로 코드에 하드코딩하지 마세요)
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxx

# 2. Vector DB (Qdrant / Chroma)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=

# 3. Redis (Token Bucket Rate Limiting & Cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# 4. Central Logging (Fluent Bit & Elasticsearch)
FLUENT_BIT_HOST=localhost
FLUENT_BIT_PORT=24224
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200

# 5. Local LLM Server (Ollama)
OLLAMA_BASE_URL=http://localhost:11434

# 6. App Settings
APP_ENV=development
LOG_LEVEL=INFO
RATE_LIMIT_RPM=60
RATE_LIMIT_TPM=100000
